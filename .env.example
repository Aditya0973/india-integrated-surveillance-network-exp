# India Integrated Surveillance Network (IISN) - Environment Configuration
PORT=5200

# Cesium Ion Access Token (Required for 3D Photoreal Globe & Satellite imagery)
# Free signup: https://ion.cesium.com/signup
CESIUM_ION_TOKEN=your_cesium_ion_token_here

# AISStream API Key (Required for live Indian EEZ maritime vessel tracking)
# Free signup: https://aisstream.io/
AISSTREAM_API_KEY=your_aisstream_key_here

# NASA FIRMS Map Key (Required for live thermal hotspots & forest fire detection)
# Free signup: https://firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_KEY=your_nasa_firms_key_here

# TomTom Developer API Key (Traffic flow overlay & Indian address geocoding)
# Free signup: https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# World Air Quality Index / AQICN Token (Real-time air pollution sensors)
# Free signup: https://aqicn.org/data-platform/token/
AQICN_TOKEN=your_aqicn_token_here

# Tactical AI Assistant Configuration
# Default: Local Ollama (qwen2.5:7b)
OLLAMA_MODEL=qwen2.5:7b

# Optional Remote AI Provider (openrouter or openai)
# AI_PROVIDER=openrouter
# AI_API_KEY=your_openrouter_or_openai_key_here
